    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
