    "integrations:check": "tsx scripts/check-integrations.ts",
    "format": "prettier --write src scripts tests docs",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "release:check": "tsx scripts/check-hosted-release.ts",
    "test:financial:concurrency": "tsx scripts/verify-financial-concurrency.ts",
    "showcase": "node scripts/start-showcase.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@google/genai": "^2.32.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "ag-studio": "3.1.0",
    "ag-studio-react": "3.1.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
