# Copy to .env. Never commit credentials.
APP_URL=http://localhost:3000
# Use the existing dedicated classequity-db. Empty locally enables durable PGlite.
DATABASE_URL=
# Generate each with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=
DEMO_MODE=true
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
GEMINI_API_KEY=
# Discovered and generation-tested during this build; runtime re-discovers availability.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Vendor client licence: deliberately sent only to authenticated Studio users.
AG_STUDIO_LICENSE_KEY=
