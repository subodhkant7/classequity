# ClassEquity public environment template — copy to .env; NEVER commit actual values.
# No credentials are needed for: npm ci && npm run showcase
# Canonical origin. In production use your exact HTTPS origin, with no trailing path.
APP_URL=http://localhost:3000
# Local custom development: empty = durable PGlite.
# Hosted: private PostgreSQL 17 connection to a database named classequity.
DATABASE_URL=
# Generate two DIFFERENT strong values: openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=
# Interactive demo workspace enabled for this hackathon; not real-school identity management.
DEMO_MODE=true
# MUST be true on hosted public services; public demos cannot call cloud AI.
HOSTED_RESTRICT_PUBLIC_AI=false
# Only sandbox payments are implemented.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering your own Sandbox webhook; never copy a different account's ID.
PAYPAL_WEBHOOK_ID=
# Optional: Twilio WhatsApp requires your own approved sender and user opt-in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio's PUBLIC shared Sandbox example number, not a private credential.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional in the showcase, but required by the current hosted release preflight.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Optional licensed vendor key, per AG Studio terms.
AG_STUDIO_LICENSE_KEY=
